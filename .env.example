# Supabase Realtime powers online rooms (Broadcast + Presence only; no database tables).
# Copy to .env.local for local dev, and add both to Vercel → Project → Settings → Environment Variables.
# Without them, online rooms fall back to a test mode that only connects tabs in one browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
